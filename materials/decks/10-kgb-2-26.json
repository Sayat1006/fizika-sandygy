ия?","кемімейді"],["Карно циклі неден тұрады?","2 изотерма + 2 адиабата"]],"qr":"data:image/png;base64,","qrLabel":"LearningApps"},{"t":"reflect","tag":"Рефлексия","time":"Сабақтың соңы · 7 мин","title":"«Бес саусақ»","text":"бас бармақ – не білдім; балан үйрек – кімге көмектестім; ортан терек – көңіл-күйім; шылдыр шүмек – не қиын болды; кішкене бөбек – не үйрендім.","scale":[["9–10","Өте жақсы"],["7–8","Жақсы"],["5–6","Қанағаттанарлық"],["0–4","Қолдау қажет"]]},{"t":"homework","tag":"Үй тапсырмасы","time":"Сабақтың соңы","title":"Үйде орында","items":[["A","§26; 3 есеп."],["B","Үйдегі қайтымсыз процестердің 5 мысалы."]]},{"t":"end","title":"Сабаққа белсенді қатысқандарыңа рахмет!","quote":{"text":"Бірлік бар жерде – тірлік бар» (халық мақалы).","by":""}}]}