ng","w":700,"h":450},"illus":{"k":"block_forces","a":[[["N","up",2],["mg","down",2]],"Тыныштықтағы дене"]},"items":["Параметрлерді өзгертіп көр: не өзгереді?","Қандай заңдылықты байқадың?","Нәтижені формуламен тексер."]},{"t":"link","tag":"Виртуалды зертхана","time":"Сабақтың ортасы · 12 мин","title":"PhET симуляциясы","items":["Симуляцияны QR-код арқылы ашыңдар","Параметрлерді өзгертіп, нәтижені бақылаңдар","Қандай шама қалай өзгереді? Қорытындыны дәптерге жазыңдар"],"url":"https://phet.colorado.edu/en/simulations/forces-and-motion-basics","qr":"data:image/png;base64,"},{"t":"text","tag":"Бекіту: «Карусель»","time":"Сабақтың ортасы · 7 мин","title":"Карусель","paras":["Топтар кезекпен әр үстелдегі тапсырманы орындап, келесіге ауысады, алдыңғы топтың шешімін тексереді."],"task":"**Тәжірибе:** стақан үстіне картон, оның үстіне тиын қойылады. Картонды кенет тартқанда тиын стақанға түседі. Түсіндіріңдер."},{"t":"break","tag":"Сергіту сәті","time":"Сабақтың ортасы · 2 мин","title":"Сергіп алайық","text":"**«Молекулалар».** Оқушылар қатты дене, сұйық, газ молекулаларының қозғалысын қимылмен көрсетеді."},{"t":"levels","tag":"Деңгейлік тапсырмалар","time":"Сабақтың ортасы · 11 мин","title":"Деңгейіңді таңда","items":[["A","білу, түсіну"],["B","қолдану"],["C","талдау, жинақтау"]],"note":"А деңгейін орындасаң — В деңгейіне өт!"},{"t":"task","level":"A","tag":"А деңгейі: білу, түсіну","time":"Сабақтың ортасы · 11 мин","q":"Инерцияға 3 мысал келтір.","answer":"Тежелген автобус, кілемді қағу, балғаның сабын соғу, итті сілкінген судан."},{"t":"task","level":"B","tag":"В деңгейі: қолдану","time":"Сабақтың ортасы · 11 мин","q":"Неліктен жүгіріп келе жатқан адам шалынғанда алға, ал тайғанақта артқа құлайды?","answer":"Шалынғанда аяқ тоқтайды, дене алға қозғалысын жалғастырады; тайғанақта аяқ алға тайып, дене артта қалады."},{"t":"task","level":"C","tag":"С деңгейі: талдау, жинақтау","time":"Сабақтың ортасы · 11 мин","q":"Неліктен жүк көлігінің тежелу жолы жеңіл көліктікінен ұзақ? Жол ережесіндегі «ара қашықтық сақтау» талабын инерциямен негізде.","answer":"Массасы көп – инерттілігі көп, жылдамдығын өзгертуге көбірек уақыт керек."},{"t":"qa","tag":"Бекіту: Google Forms викторинасы","time":"Сабақтың соңы · 7 мин","title":"Тез жауап бер","items":[["Дененің жылдамдығын сақтау құбылысы?","инерция"],["Кенет тежегенде жолаушы қайда ауады?","алға"],["Қай дененің инерттілігі көп: доп па, көлік пе?","көлік"]],"qr":"data:image/png;base64,","qrLabel":"Google Forms"},{"t":"reflect","tag":"Рефлексия","time":"Сабақтың соңы · 7 мин","title":"«PMI» (Плюс – Минус – Қызықты)","text":"сабақтың жақсы жағы, жетілдіретін тұсы және қызықты сәті.","scale":[["9–10","Өте жақсы"],["7–8","Жақсы"],["5–6","Қанағаттанарлық"],["0–4","Қолдау қажет"]]},{"t":"homework","tag":"Үй тапсырмасы","time":"Сабақтың соңы","title":"Үйде орында","items":[["A","§16; 5 мысал жазу."],["B","Тиын-картон тәжірибесін үйде жасап, видеоға түсіру."],["C","Галилейдің инерция туралы тәжірибелері туралы хабарлама."]]},{"t":"end","title":"Сабаққа белсенді қатысқандарыңа рахмет!","quote":{"text":"Тура биде туған жоқ» (халық мақалы).","by":""}}],"quiz":[["Ньютонның I заңы бойынша, күштер теңгерілсе дене:",["Шеңбер бойымен қозғалады","Үдеумен қозғалады","Міндетті түрде тоқтайды","Тыныштықта немесе бірқалыпты түзу қозғалыста болады"],"Тыныштықта немесе бірқалыпты түзу қозғалыста болады"],["Инерттілік өлшемі:",["Күш","Көлем","Жылдамдық","Масса"],"Масса"],["Инерциялық санақ жүйесі:",["Айналатын карусель","Тежелетін пойыз","Бұрылыстағы автобус","Бірқалыпты түзу қозғалатын жүйе"],"Бірқалыпты түзу қозғалатын жүйе"],["Кілемді таяқпен ұрғанда шаң неліктен ұшады?",["Шаң тартылады","Шаң электрленеді","Ауа үрлейді","Шаң инерциясымен орнында қалады"],"Шаң инерциясымен орнында қалады"]]}