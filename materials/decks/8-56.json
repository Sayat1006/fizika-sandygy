ында","items":[["A","§37; 2 сызба."],["B","Қасықтың ойыс/дөңес беттеріндегі кескінді бақылау."],["C","Күн электр станцияларындағы ойыс айналар туралы хабарлама."]]},{"t":"end","title":"Сабаққа белсенді қатысқандарыңа рахмет!","quote":{"text":"Ғылым таппай мақтанба","by":"Абай Құнанбайұлы"}}],"quiz":[["Адам жазық айнадан 2 м қашықта. Кескінге дейінгі арақашықтық:",["2 м","4 м","1 м","8 м"],"4 м"],["Ойыс айнаның фокус аралығы мен қисықтық радиусы байланысы:",["F = R/2","F = R","F = 2R","F = R²"],"F = R/2"],["Шашыранды шағылу қай бетте болады?",["Жылтыр металда","Тынық су бетінде","Бұдырлы бетте (қағаз)","Айнада"],"Бұдырлы бетте (қағаз)"],["Шағылу заңы:",["Бұрыштар қосындысы 180°","Түсу бұрышы шағылу бұрышына тең","Түсу бұрышы 90°","Шағылу бұрышы 2 есе үлкен"],"Түсу бұрышы шағылу бұрышына тең"]]}