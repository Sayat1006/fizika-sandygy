{
  "buildCommand": "npm --prefix web ci && npm --prefix web run build",
  "outputDirectory": "dist",
  "regions": [
    "fra1"
  ],
  "functions": {
    "api/download.js": {
      "includeFiles": "materials/**",
      "maxDuration": 20
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/lab/:path*",
      "destination": "/lab"
    },
    {
      "source": "/((?!api/|lab$|lab/|assets/).*)",
      "destination": "/index.html"
    }
  ]
}
