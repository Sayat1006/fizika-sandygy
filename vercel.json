{
  "outputDirectory": "public",
  "regions": [
    "fra1"
  ],
  "functions": {
    "api/download.js": {
      "includeFiles": "materials/**",
      "maxDuration": 20
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "cleanUrls": true
}