 викторинасы","time":"Сабақтың соңы · 7 мин","title":"Тез жауап бер","items":[["υ = υ₀ + at: 0 + 3·4","12 м/с"],["s = at²/2: a = 2, t = 3","9 м"],["Тежелуде a таңбасы?","теріс"]],"qr":"data:image/png;base64,","qrLabel":"Quizizz"},{"t":"reflect","tag":"Рефлексия","time":"Сабақтың соңы · 7 мин","title":"«3 – 2 – 1»","text":"3 жаңа ұғым, 2 қызықты дерек, 1 сұрақ.","scale":[["9–10","Өте жақсы"],["7–8","Жақсы"],["5–6","Қанағаттанарлық"],["0–4","Қолдау қажет"]]},{"t":"homework","tag":"Үй тапсырмасы","time":"Сабақтың соңы","title":"Үйде орында","items":[["A","§4; 4 есеп."],["B","Мектеп жанындағы жолда жылдамдық шектеуі мен тежелу жолын есептеу."],["C","Жол қауіпсіздігі бойынша инфографика."]]},{"t":"end","title":"Сабаққа белсенді қатысқандарыңа рахмет!","quote":{"text":"Еңбек етсең ерінбей, тояды қарның тіленбей","by":"Абай Құнанбайұлы"}}]}