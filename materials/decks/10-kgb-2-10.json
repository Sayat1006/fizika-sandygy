ай күш береді?","answer":"F₂ = 200·500/10 = 10 000 Н."},{"t":"qa","tag":"Бекіту: LearningApps викторинасы","time":"Сабақтың соңы · 7 мин","title":"Тез жауап бер","items":[["F₂/F₁ = ?","S₂/S₁"],["Қалыпты атмосфералық қысым?","760 мм сын. бағ."],["p = ?","ρgh"]],"qr":"data:image/png;base64,","qrLabel":"LearningApps"},{"t":"reflect","tag":"Рефлексия","time":"Сабақтың соңы · 7 мин","title":"«Шығу парағы»","text":"стикерге бір жаңа білімін және бір сұрағын жазып, есік алдындағы тақтаға жапсырады.","scale":[["9–10","Өте жақсы"],["7–8","Жақсы"],["5–6","Қанағаттанарлық"],["0–4","Қолдау қажет"]]},{"t":"homework","tag":"Үй тапсырмасы","time":"Сабақтың соңы","title":"Үйде орында","items":[["A","Оқулықтағы тақырыпты оқу; 3 есеп шығару."],["B","Үйдегі қатынас ыдыстарды тауып, суретпен сипатта."]]},{"t":"end","title":"Сабаққа белсенді қатысқандарыңа рахмет!","quote":{"text":"Отан – оттан да ыстық» (халық мақалы).","by":""}}]}